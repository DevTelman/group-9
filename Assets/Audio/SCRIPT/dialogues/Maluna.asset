%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9e88f8bf2827d94f882313335c5d094, type: 3}
  m_Name: Maluna
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - characterName: Mark
    characterEmote: {fileID: 21300000, guid: 8918ec53b36be8d40b15ff0cf39f4f83, type: 3}
    text: Maluna, can you hear me?
  - characterName: Maluna
    characterEmote: {fileID: 21300000, guid: 90ace58d81e7ad14f8eb29173136c7d8, type: 3}
    text: Yes, but who are you? I dont recognise your voice
  - characterName: Mark
    characterEmote: {fileID: 21300000, guid: 8918ec53b36be8d40b15ff0cf39f4f83, type: 3}
    text: 'My name is Mark, and i came here to stop  the pollution '
  - characterName: Mark
    characterEmote: {fileID: 21300000, guid: 08b7620d99209c4409c4cbfb1dea97c0, type: 3}
    text: But i need your help
  - characterName: Mark
    characterEmote: {fileID: 21300000, guid: d63734fc83894d845b8066bb317b3c1c, type: 3}
    text: I maet Warden and he said that you will help me
  - characterName: Mark
    characterEmote: {fileID: 21300000, guid: 08b7620d99209c4409c4cbfb1dea97c0, type: 3}
    text: I cant access lower floors
  - characterName: Maluna
    characterEmote: {fileID: 21300000, guid: 418bb516ce3a32343841da38419ada40, type: 3}
    text: You are right.Its too dangerous here for a child
  - characterName: Maluna
    characterEmote: {fileID: 21300000, guid: 90ace58d81e7ad14f8eb29173136c7d8, type: 3}
    text: I barely survive here
  - characterName: Maluna
    characterEmote: {fileID: 21300000, guid: 418bb516ce3a32343841da38419ada40, type: 3}
    text: Corrupted plants are suffering here
  - characterName: Maluna
    characterEmote: {fileID: 21300000, guid: 418bb516ce3a32343841da38419ada40, type: 3}
    text: 'It would be great to shut down the Great Machine and save the plants from
      pollution '
  - characterName: Mark
    characterEmote: {fileID: 21300000, guid: 8918ec53b36be8d40b15ff0cf39f4f83, type: 3}
    text: We can do it togeother!
  - characterName: Maluna
    characterEmote: {fileID: 21300000, guid: e24e13056241bb4438ef6b0d9f8df525, type: 3}
    text: Really?
  - characterName: Mark
    characterEmote: {fileID: 21300000, guid: 8918ec53b36be8d40b15ff0cf39f4f83, type: 3}
    text: Yes! I will fix the gears, and you will be able to fix the pipes
  - characterName: Maluna
    characterEmote: {fileID: 21300000, guid: 90ace58d81e7ad14f8eb29173136c7d8, type: 3}
    text: Hmm
  - characterName: Maluna
    characterEmote: {fileID: 21300000, guid: b85d4fbe2fba2534e815423db8ac5b2c, type: 3}
    text: I think it will work
  - characterName: Maluna
    characterEmote: {fileID: 21300000, guid: b5a4af4a49331ca4f8f84793e3efd9f1, type: 3}
    text: Alriht then!
